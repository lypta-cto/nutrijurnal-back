# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- App ---------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=false

# --- Database ----------------------------------------------------------------
# Local (docker compose up -d db):
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5437/nutrijurnal
# A hosted Postgres: take its connection string, swap the driver to
# postgresql+asyncpg and drop any ?sslmode=require (asyncpg negotiates TLS itself).

# --- Security ----------------------------------------------------------------
# Generate one with: python -m app.cli secret
SECRET_KEY=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cookies -----------------------------------------------------------------
# Must be true in production (HTTPS). Use samesite=none only when the API and
# the frontend are on different sites — and then secure must be true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- URLs / CORS -------------------------------------------------------------
BACKEND_URL=http://localhost:8004
FRONTEND_URL=http://localhost:3400
CORS_ORIGINS=http://localhost:3400

# --- Google OAuth ------------------------------------------------------------
# Off unless both are set. https://console.cloud.google.com/apis/credentials →
# Create OAuth client ID → Web application, with this redirect URI:
#   http://localhost:8004/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reminders (Web Push) -----------------------------------------------------
# Generate a pair with: python -m app.cli vapid
# Reminders are kept without them, but nothing is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# The in-process loop that sends due reminders and tidies up once a minute
REMINDERS_ENABLED=true

# --- Seed --------------------------------------------------------------------
# The shared foods load on boot; turn off when the deploy step runs
# `python -m app.cli seed` instead.
SEED_FOODS_ON_STARTUP=true

# --- Operator account --------------------------------------------------------
# Used once by: python -m app.cli owner
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme123
